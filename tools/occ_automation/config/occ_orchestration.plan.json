  "permissions": {
    "read_explicit_project_sources": true,
    "local_intake_metadata_reports": true,
    "propose_docs_and_code": true,
    "arbitrary_shell": false,
    "automatic_installation": false,
    "automatic_push": false,
    "automatic_merge": false,
    "signing": false,
    "transactions": false,
    "wallet_credentials": false,
    "automatic_capital_increase": false,
    "modify_capability_or_release_gates": false
  }

{
  "schema_version": "gpr.interchain-relations.v2",
  "execution_policy": "RESEARCH_ONLY_NON_ATOMIC",
  "rule": "No bridge edge enters the atomic UniversalArbitrageGraph. Cross-chain opportunities require prefunded local execution and later rebalance in a future simulator.",
  "edge_types": [
    {
      "id": "ISSUER_EQUIVALENCE",
      "example": "FDUSD_SOL <-> FDUSD_SUI"
    },
    {
      "id": "NATIVE_BURN_MINT",
      "example": "USDC_SOL <-> USDC_SUI via CCTP"
    },
    {
      "id": "LOCK_MINT_BRIDGE",
      "example": "SOL_SOL <-> WSOL_WORMHOLE_SUI"
    },
    {
      "id": "ECONOMIC_UNDERLYING",
      "example": "cbBTC_SOL <-> XBTC_SUI <-> WBTC_SUI representations"
    },
    {
      "id": "PROTOCOL_REDEMPTION",
      "example": "JitoSOL -> SOL; afSUI -> SUI"
    },
    {
      "id": "INVENTORY_REBALANCE",
      "example": "prefunded Solana inventory <-> prefunded Sui inventory"
    }
  ],
  "initial_watch_set": [
    {
      "id": "IX-01",
      "kind": "NATIVE_BURN_MINT",
      "left": "solana-mainnet:USDC",
      "right": "sui-mainnet:USDC_NATIVE",
      "signal": "native USDC basis / CCTP rebalance reference"
    },
    {
      "id": "IX-02",
      "kind": "ECONOMIC_UNDERLYING",
      "left": "solana-mainnet:USDC",
      "right": "sui-mainnet:USDC_WORMHOLE",
      "signal": "native-vs-bridged USDC basis"
    },
    {
      "id": "IX-03",
      "kind": "LOCK_MINT_BRIDGE",
      "left": "solana-mainnet:SOL",
      "right": "sui-mainnet:WSOL_WORMHOLE",
      "signal": "SOL native-basis residual"
    },
    {
      "id": "IX-04",
      "kind": "ISSUER_EQUIVALENCE",
      "left": "solana-mainnet:FDUSD",
      "right": "sui-mainnet:FDUSD",
      "signal": "same-issuer stablecoin cross-chain basis"
    },
    {
      "id": "IX-05",
      "kind": "ISSUER_EQUIVALENCE",
      "left": "solana-mainnet:USDY",
      "right": "sui-mainnet:USDY",
      "signal": "yield-asset market basis vs reference value"
    },
    {
      "id": "IX-06",
      "kind": "ECONOMIC_UNDERLYING",
      "left": "solana-mainnet:BTC_REPRESENTATION_FAMILY",
      "right": "sui-mainnet:BTC_REPRESENTATION_FAMILY",
      "signal": "BTC representation basis"
    },
    {
      "id": "IX-07",
      "kind": "CROSS_CHAIN_RATE_COMPARISON",
      "left": "SOL/USDC@solana-mainnet",
      "right": "WSOL_WORMHOLE/USDC_NATIVE@sui-mainnet",
      "signal": "SOL/USD chain basis net of hedge/rebalance costs"
    },
    {
      "id": "IX-08",
      "kind": "CROSS_CHAIN_RATE_COMPARISON",
      "left": "FDUSD/USDC@solana-mainnet",
      "right": "FDUSD/USDC_NATIVE@sui-mainnet",
      "signal": "FDUSD/USD chain basis"
    },
    {
      "id": "IX-09",
      "kind": "CROSS_CHAIN_RATE_COMPARISON",
      "left": "USDY/USDC@solana-mainnet",
      "right": "USDY/USDC_NATIVE@sui-mainnet",
      "signal": "USDY yield-basis divergence"
    },
    {
      "id": "IX-10",
      "kind": "CROSS_CHAIN_RATE_COMPARISON",
      "left": "BTC_REPRESENTATION/USDC@solana-mainnet",
      "right": "BTC_REPRESENTATION/USDC_NATIVE@sui-mainnet",
      "signal": "BTC wrapper basis"
    },
    {
      "id": "IX-11",
      "kind": "REGIME_COMPARISON",
      "left": "SOLANA_LST_PREMIUM",
      "right": "SUI_LST_PREMIUM",
      "signal": "staking/restaking premium regime"
    },
    {
      "id": "IX-12",
      "kind": "REGIME_COMPARISON",
      "left": "SOLANA_FUNDING_RATE",
      "right": "SUI_FUNDING_RATE",
      "signal": "funding/capital-cost divergence"
    }
  ],
  "future_prefunded_candidate_economics": [
    "gross cross-chain spread",
    "local execution fees",
    "hedge cost",
    "inventory opportunity cost",
    "expected bridge/rebalance cost",
    "bridge latency risk",
    "capital fragmentation cost"
  ]
}
